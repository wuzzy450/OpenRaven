# Keep Linux scripts and sources LF, Windows scripts CRLF, binaries untouched
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.ini text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.so binary
*.so.* binary
*.exe binary

# Kept in the repo, left out of the release zip (git archive): test launchers and the release tool
play_solo.bat export-ignore
play_solo_fill.bat export-ignore
make_release.sh export-ignore
